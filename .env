# Valeurs communes, sans secret (commité). Les secrets et ce qui est propre au serveur vont dans .env.local
# (modèle : .env.local.dist).
NODE_ENV=production
PORT=3000
TZ=Europe/Paris
DB_PATH=/data/isoloir.db
# Le nombre maximum de procurations qu'un même mandataire peut détenir (souvent fixé par les statuts).
MAX_PROXIES=1
# Le dépôt du code : le numéro de version du pied de page y renvoie.
REPO_URL=https://github.com/jarash/isoloir
