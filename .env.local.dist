# Modèle du .env.local du serveur (voir docs/deploiement.md) : copier en .env.local, remplir chaque valeur.
#   cp .env.local.dist .env.local && chmod 600 .env.local
# Le .env.local n'est jamais commité : il contient les secrets.

###> Instance ###
# Le nom de cette installation : son conteneur, son volume et son dossier de sauvegardes le portent.
INSTANCE_NAME=isoloir
# Le port local où le Caddy du serveur la joint (reverse_proxy 127.0.0.1:8084). Un port libre, différent de ceux des
# autres sites du serveur (La Compo : 8083).
HTTP_PORT=8084
# Si le Caddy du serveur tourne lui-même dans Docker, il ne voit pas le 127.0.0.1 du serveur : écouter sur le pont
# Docker (ip -4 addr show docker0, souvent 172.17.0.1) et y pointer son reverse_proxy.
# HTTP_BIND_IP=172.17.0.1
###< Instance ###

###> Application ###
# L'adresse publique du site, sans / final : l'adresse de retour donnée à Discord est construite avec.
BASE_URL=https://isoloir.exemple.fr
# Les identifiants Discord des admins du scrutin, séparés par des virgules (Discord → Paramètres → Avancés → Mode
# développeur, puis clic droit sur son profil → Copier l'identifiant).
ADMIN_IDS=
###< Application ###

###> Mentions légales et confidentialité (page /confidentialite) ###
# Qui édite le site : le nom de l'association (et « association loi 1901 »), son adresse ou son siège.
LEGAL_PUBLISHER="FrenchCraft, association loi 1901"
LEGAL_ADDRESS=
# Le directeur ou la directrice de la publication : en général le ou la présidente.
LEGAL_DIRECTOR=
# L'hébergeur du VPS : nom, adresse, téléphone (ex. « OVH SAS, 2 rue Kellermann, 59100 Roubaix, 1007 »).
LEGAL_HOST=
# L'adresse à qui écrire au sujet de ses données.
CONTACT_EMAIL=
# Combien de temps les données du scrutin sont gardées après l'AG (le délai de contestation, souvent 2 mois).
RETENTION="2 mois après l'AG"
###< Mentions légales et confidentialité ###

###> Discord ###
# L'application OAuth2 (https://discord.com/developers/applications), avec l'adresse de retour
# https://isoloir.exemple.fr/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Facultatif : l'identifiant du serveur Discord de l'association. Rempli, seuls ses membres peuvent se connecter.
GUILD_ID=
# Facultatif (avec GUILD_ID) : l'identifiant du rôle des membres votants (ex. « Adhérent à jour »). Rempli, seuls les
# membres qui ont ce rôle reçoivent un bulletin.
VOTER_ROLE_ID=
###< Discord ###
