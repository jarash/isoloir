{
  "name": "isoloir",
  "version": "1.0.0",
  "description": "Vote anonyme de l'élection du bureau en AG, connexion avec Discord, procurations et résultats visuels.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarash/isoloir.git"
  },
  "homepage": "https://github.com/jarash/isoloir#readme",
  "bugs": {
    "url": "https://github.com/jarash/isoloir/issues"
  },
  "keywords": [
    "vote",
    "élection",
    "assemblée générale",
    "association",
    "discord",
    "anonyme"
  ],
  "private": true,
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --env-file-if-exists=.env.local server.js",
    "dev": "DEV_LOGIN=1 NODE_ENV=development DB_PATH=var/isoloir.db BASE_URL=http://localhost:3000 node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch server.js",
    "test": "node --disable-warning=ExperimentalWarning --test"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
